name: 12306去广告
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  body-rewrite:
  - ^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ response-json-del materialsList advertParam
  script:
  - name: loon-12306_remove_ads-e4e07d3c
    match: ^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$
    type: request
    timeout: 10
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - ad.12306.cn
  - mobile.12306.cn
script-providers:
  loon-12306_remove_ads-e4e07d3c:
    url: https://raw.githubusercontent.com/liristy/ssrules/main/stash-plugins/runtime/loon-12306_remove_ads-e4e07d3c-8bf1e9cd1adc.js
    interval: 86400
