name: Apple天气增强
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  script:
  - name: loon-response.bundle-a0309086
    match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/
    type: response
    require-body: true
    argument: Weather.Provider=ColorfulClouds&NextHour.Provider=ColorfulClouds&AirQuality.Calculate.Algorithm=EU_EAQI&API.ColorfulClouds.Token=&API.QWeather.Host=devapi.qweather.com&API.QWeather.Token=&API.WAQI.Token=&Storage=Argument&LogLevel=WARN
    timeout: 10
    max-size: 1048576
  - name: loon-response.bundle-a0309086
    match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
    type: response
    require-body: true
    binary-mode: true
    argument: Weather.Provider=ColorfulClouds&NextHour.Provider=ColorfulClouds&AirQuality.Calculate.Algorithm=EU_EAQI&API.ColorfulClouds.Token=&API.QWeather.Host=devapi.qweather.com&API.QWeather.Token=&API.WAQI.Token=&Storage=Argument&LogLevel=WARN
    timeout: 10
    max-size: 1048576
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - weatherkit.apple.com
script-providers:
  loon-response.bundle-a0309086:
    url: https://raw.githubusercontent.com/liristy/ssrules/main/stash-plugins/runtime/loon-response.bundle-a0309086-eea5c91be5b3.js
    interval: 86400
