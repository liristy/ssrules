name: 广告平台拦截器
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  url-rewrite:
  - ^https:\/\/video-dsp\.pddpic\.com\/market-dsp-video\/ - reject
  - ^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_ - reject
  - ^https:\/\/images\.pinduoduo\.com\/mrk\/ - reject
  - ^https:\/\/images\.pinduoduo\.com\/marketing_api\/ - reject
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - video-dsp.pddpic.com
  - t-dsp.pinduoduo.com
  - images.pinduoduo.com
rules:
- URL-REGEX,^http:\/\/.+\/amdc\/mobileDispatch,REJECT
