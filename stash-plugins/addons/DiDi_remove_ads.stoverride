name: 滴滴去广告
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  body-rewrite:
  - ^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\? response-jq .data |= map(select(.name != "isUseNetConnectivity") | .assign.args.rootca_pin
    = 0 | .assign.args.sni_list = {})
  - ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/slow\? response-json-del data.order_cards.new_loss_banner_card
    data.order_cards.call_car_card_80
  - ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core\? response-jq .data.order_cards.nav_list_card.data |= map(select(.nav_id
    == "dache_anycar" or .nav_id == "carmate" or .nav_id == "driverservice" or .nav_id == "zhandianbashi" or .nav_id == "pincheche"
    or .nav_id == "bike" or .nav_id == "nav_more_v3")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.nav_id
    == "chu_xing" or .nav_id == "freight_cargo"))
  - ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\? response-json-del data.disorder_cards.communicate_card
    data.disorder_cards.not_login_bottom_bar data.disorder_cards.riding_code_card data.order_cards data.disorder_cards.car_icon.data.icon_info_new_agreement
  - ^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/layout response-jq .data |= (.instances |= (to_entries
    | map(select(.key as $k | ["center_base_info_card", "center_tool_card", "center_wallet_finance_card", "center_order_related_card"]
    | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券"))
  - ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\? response-json-del data.disorder_cards.guess_card data.disorder_cards.scene_list_card
  - ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\? response-json-del data.instances.dache_main_core_icon
  - ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\? response-jq .data |= (.instances |= (to_entries
    | map(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) | from_entries))
  - ^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v\d\/core\/getFullPageInfoLayout\? response-jq .data.disorder_components
    |= (map(select(.name == "history_order_card" or .name == "inprogress_order_card" or .name == "station_calendar" or .name
    == "main_card_v2" or .name == "user_history_order")))
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloConfig response-jq .data |= map(select(.name != "daijia-memberInfo-config"
    and .name != "daijia-transfer-share-config"))
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloToggle response-jq .data |= map(select(.name as $n
    | {daijia_app_estimate_pre_req_switch:true,daijia_agent_car_picture_check:true,daijia_bluetooth_wifi_degrade_switch:true,daijia_weixin_publish_login:true,daijia_estimate_recommend_degrade_switch:true,daijia_yugu_policy_switch:true,daijia_home_location_guide_switch:true,daijia_estimate_switch:true}
    | has($n)))
  - ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/bronze\/pinchengle_homepage_layout$ response-jq .data.instances
    |= with_entries(select(.key | IN("dacheanycar-certificates-1", "main-card-1", "map-1", "nav-1", "tool-container-1")))
  - ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/SFCHomeTab\? response-jq .data.tab_list |= map(select(.tab_id ==
    "passenger" or .tab_id == "driver"))
  - ^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.querySellCardSummary response-json-replace data {}
  - ^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.queryWelfareCenter response-json-replace data {}
  - ^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/startinfo\?api_version response-json-del rec_destination
  - ^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/poiinfo\?product_id response-json-del rec_destination
  - ^https:\/\/common\.diditaxi\.com\.cn\/user_common\/itineraryList\? response-jq del(.data.tab_nav[]?.tab_param)
  url-rewrite:
  - ^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\? - reject-dict
  - ^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget$ - reject-dict
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.delivery\.batch - reject-dict
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery -
    reject-dict
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus - reject-dict
  - ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.p\.popup - reject-dict
  - ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/pSFCHomePage\? - reject-dict
  - ^https:\/\/htwkop-st\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery\.batch - reject-dict
  - ^https:\/\/freight\.xiaojukeji\.com\/gateway\?api=freight\.d\.core\.multiDisplayV\d - reject-dict
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - as.xiaojukeji.com
  - conf.diditaxi.com.cn
  - common.diditaxi.com.cn
  - res.xiaojukeji.com
  - api.udache.com
  - daijia.kuaidadi.com
  - htwkop-st.xiaojukeji.com
  - htwkop.xiaojukeji.com
  - freight.xiaojukeji.com
  - poi.map.xiaojukeji.com
