name: 叮咚买菜去广告
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  url-rewrite:
  - ^https?:\/\/119\.29\.29\.\d+\/d - reject-200
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/ - reject
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop - reject
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rollHotKeyword\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rankingList\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/search\/hotKeyword\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend$ - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike\? - reject-dict
  - ^https:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v1\/user\/queryMyPage\/\? - reject-dict
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/userLike\/flowData$ - reject-dict
  body-rewrite:
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\? response-json-del data.ad_info
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig\? response-json-del data.ai_enter_config
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? response-json-del data.top_advert_data data.suspension
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? response-jq .data.list |= map(select(has("capsule_freedom_zone")
    | not))
  - ^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/productApi\/productDetail\/info\? response-json-del data.detail.chatEntry
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/bottomNavi response-jq del(.data.adId?) | if (.data.bottom_list? | length
    > 0) then .data.bottom_list |= map(select(.type != "eatwhat")) else . end
  - ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail response-jq walk(if type == "object" and has("list") then
    .list |= map(if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end)
    else . end)
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - 119.29.29.*
  - maicai.api.ddxq.mobi
  - user.api.ddxq.mobi
