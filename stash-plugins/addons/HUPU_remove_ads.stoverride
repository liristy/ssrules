name: 虎扑去广告
desc: 可选 JavaScript 增强；配合主覆写及已信任的 MITM 证书使用。
date: '2026-09-16'
http:
  script:
  - name: loon-HUPU_remove_ads-09e8dc8c
    match: ^https:\/\/fairy\.mobileapi\.hupu\.com\/mang\/preview\/banners
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  - name: loon-HUPU_remove_ads-09e8dc8c
    match: ^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/lego\/data
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  - name: loon-HUPU_remove_ads-09e8dc8c
    match: ^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/buffer\/hotList
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  - name: loon-HUPU_remove_ads-09e8dc8c
    match: ^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplapi\/user\/v1\/more
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - games.mobileapi.hupu.com
  - fairy.mobileapi.hupu.com
  - bbs.mobileapi.hupu.com
  - goblin.hupu.com
script-providers:
  loon-HUPU_remove_ads-09e8dc8c:
    url: https://raw.githubusercontent.com/liristy/ssrules/main/stash-plugins/runtime/loon-HUPU_remove_ads-09e8dc8c-d5ce9a77d2d5.js
    interval: 86400
