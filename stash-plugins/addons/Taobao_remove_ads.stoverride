name: 淘宝去广告
desc: 可选 JavaScript 增强；配合主覆写及已信任的 MITM 证书使用。
date: '2026-09-16'
http:
  script:
  - name: loon-Taobao_remove_ads-9d853d73
    match: ^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  - name: loon-Taobao_remove_ads-9d853d73
    match: ^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json
    type: response
    require-body: true
    timeout: 10
    max-size: 1048576
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - acs.m.taobao.com
  - heic.alicdn.com
  - guide-acs.m.taobao.com
  - poplayer.template.alibaba.com
script-providers:
  loon-Taobao_remove_ads-9d853d73:
    url: https://raw.githubusercontent.com/liristy/ssrules/main/stash-plugins/runtime/loon-Taobao_remove_ads-9d853d73-24f6ebcb82bb.js
    interval: 86400
