name: 知乎去广告
desc: 可选增强，请按需启用；需要轻量主覆写与已信任的 MITM 证书。
date: '2026-09-16'
http:
  body-rewrite:
  - '^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\? response-jq def drop_keys: {"km_httpdns_new_config_tars":true,"preFetchHttpDns":true,"httpdns_detector_use_concurrent":true,"httpdns_use_memory_cache":true,"httpdns_new_config_tars":true,"coreNetworkConf_useTars":true,"km_coreNetworkConf_useTars":true,"sugarQuicConfig":true,"quic_dns_detect_enable":true,"quicMixAB":true,"quic_downgrade_enable":true,"quic_priority_strategy":true,"quic_check_health_enable":true,"tquic_configuration":true,"networkExprimentList":true,"tars_ab_list":true,"zaSetExtraRequestHeader":true};
    .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == "object" then del(.configValue.delayHttpdns,
    .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
  - ^https:\/\/api\.zhihu\.com\/root\/tab\/v\d(?:\?.+)?$ response-jq .tab_list |= map(select(.tab_type == "follow" or .tab_type
    == "recommend" or .tab_type == "hot" or .tab_type == "ring_tab"))
  - ^https:\/\/api\.zhihu\.com\/topstory\/recommend\? response-jq .data |= map(select(.type == "ComponentCard"))
  - ^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds\? response-json-del ad_info
  - ^https:\/\/api\.zhihu\.com\/comment_v\d\/(answers|pins)\/\d+\/root_comment\? response-json-del atmosphere_voting_config
  - ^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ response-json-del third_business float_search_word
  - ^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ response-jq .structured_content.segments |= map(select(.type
    != "card"))
  - ^https:\/\/api\.zhihu\.com\/topstory\/recommend\? response-jq .data[]?.children |= (if type == "array" then map(select(.id
    != "ring")) else . end)
  - ^https:\/\/api\.zhihu\.com\/(articles|answers|pins)\/v\d\/\d+\? response-json-del third_business ring_info interaction_bar_plugins
  - ^https:\/\/api\.zhihu\.com\/comment_v\d\/answers\/\d+\/list-headers$ response-json-del continuous_consumption_module
  - ^https:\/\/api\.zhihu\.com\/podcasts\/hub\/v\d$ response-json-del banners
  - ^https:\/\/api\.zhihu\.com\/search\/recommend_query\/v\d\? response-jq .recommend_queries.queries |= map(select(.type
    == "normal"))
  - ^https:\/\/api\.zhihu\.com\/search_v\d\? response-json-del pendant
  - ^https:\/\/api\.zhihu\.com\/search\/tabs\? response-jq .data |= map(select(.t | IN("general", "ai_zhida", "recent", "people",
    "zvideo", "ring", "topic", "podcast", "column", "pin", "favlist")))
  - ^https:\/\/api\.zhihu\.com\/people\/self$ response-json-del vip_info.entrance_new.right_button vip_info.entrance_v2
  url-rewrite:
  - ^https:\/\/api\.zhihu\.com\/commercial_api\/ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/next-render\?id=\d+&type=answer - reject-dict
  - ^https:\/\/api\.zhihu\.com\/search\/preset_words\? - reject-dict
  - ^https:\/\/api\.zhihu\.com\/search\/related_queries\/question\/\d+$ - reject-dict
  - ^https:\/\/zhida\.zhihu\.com\/ai_ingress\/knowledge\/square\/categories\/feeds\?categoryId=1%7D$ - reject-dict
  - ^https:\/\/zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/show$ - reject-dict
  - ^https:\/\/www\.zhihu\.com\/api\/v\d\/members\/homepage_card$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v\d$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/kvip\/right\/my_card\? - reject-dict
  - ^https:\/\/api\.zhihu\.com\/unlimited\/go\/my_card\/v\d\? - reject-dict
  mitm:
  - -gateway.icloud.com
  - -gateway.icloud.com.cn
  - -weather-data.apple.com
  - -buy.itunes.apple.com
  - -ios.chat.openai.com
  - m-cloud.zhihu.com
  - api.zhihu.com
  - www.zhihu.com
  - page-info.zhihu.com
  - zhida.zhihu.com
