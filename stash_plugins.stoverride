      // Original source: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/meiyou/meiyou_ads.js
      (async function () {
      /**
       * @author fmz200
       * @function 美柚app去广告&净化
       * @date 2026-04-08 14:20:00
       */

      const $ = new Env("美柚app去广告&净化");
      let req_url = $request.url;
      let rsp_body = "{}";
