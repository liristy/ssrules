  script:
  - name: 12306 · 应用内广告
    match: (?i)^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$
    type: request
    timeout: 10
  - name: Apple天气增强 · 天气可用性响应
    match: (?i)^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/
    type: response
    require-body: true
    argument: Weather.Provider=ColorfulClouds&NextHour.Provider=ColorfulClouds&AirQuality.Calculate.Algorithm=EU_EAQI&API.ColorfulClouds.Token=&API.QWeather.Host=devapi.qweather.com&API.QWeather.Token=&API.WAQI.Token=&Storage=Argument&LogLevel=WARN
    timeout: 10
    max-size: 262144
  - name: Apple天气增强 · 天气响应
    match: (?i)^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
    type: response
    require-body: true
    binary-mode: true
    argument: Weather.Provider=ColorfulClouds&NextHour.Provider=ColorfulClouds&AirQuality.Calculate.Algorithm=EU_EAQI&API.ColorfulClouds.Token=&API.QWeather.Host=devapi.qweather.com&API.QWeather.Token=&API.WAQI.Token=&Storage=Argument&LogLevel=WARN
    timeout: 10
    max-size: 262144
  - name: YouTube去广告
    match: (?i)^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$
    type: response
    require-body: true
    binary-mode: true
    argument: '{"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}'
    timeout: 10
    max-size: 262144
  - name: YouTube · 请求初始化
    match: (?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*
