  loon-xmApp-deda3924:
    payload: |
      // Original source: https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/AdBlock/xmApp/xmApp.js
      (async function () {
      let url = $request.url;
      let Body = JSON.parse($response.body);
      if (url.match(/icon/)) {
          Body.data = {
              ...Body.data,
              big_promotion_center: {},
              active_center: {}
          }
      } else if(url.match(/index/)){
          let filtData=Body.data.filter(e=>e.hasMore);
          Body.data = filtData;
      }
      $done({ body: JSON.stringify(Body) })
      }).call(globalThis).catch(function (error) { console.log(String(error)); $done({}); });
  loon-xiaotucc-5123ae63:
    payload: |
      // Original source: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/xiaotucc.js
      (async function () {
      if (-1 != $request.url.indexOf("main_page/index/getActivity")) {
        let obj = JSON.parse($response.body);
        delete obj.data.p3;
        $done({body: JSON.stringify(obj)});
      } else if (-1 != $request.url.indexOf("mall/main")) {
        let obj = JSON.parse($response.body);
        delete obj.data;
        $done({body: JSON.stringify(obj)});
      } else $done($response);
      }).call(globalThis).catch(function (error) { console.log(String(error)); $done({}); });
  loon-yx-9aefdaf1:
    payload: |
      // Original source: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/yx.js
      (async function () {
      /**
       * 悠洗APP
       */

      let obj = JSON.parse($response.body);
      obj.data.topFunctionalArea.splice(5);
      $done({body: JSON.stringify(obj)});
      }).call(globalThis).catch(function (error) { console.log(String(error)); $done({}); });
