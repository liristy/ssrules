              continue;
            } else if (item.hasOwnProperty("card_icon")) {
              // 信息流-带货
              continue;
            } else if (item.hasOwnProperty("note_attributes")) {
              // 信息流-带货
              continue;
            } else if (item?.note_attributes?.includes("goods")) {
              // 信息流-商品
