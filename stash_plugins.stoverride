                      let page = card.mblog.page_info;
                      for (let i of page.cards) {
                        if (i?.media_info?.vote_info) {
                          delete i.media_info.vote_info;
                        }
                      }
                    }
                    newCards.push(card);
                  }
                }
              }
            }
            obj.cards = newCards;
