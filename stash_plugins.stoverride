    payload: "// Original source: https://raw.githubusercontent.com/fmz200/wool_scripts/refs/heads/main/Scripts/miguvideo/miguvideo_ads.js\n\
      (async function () {\n/**\n * @author fmz200\n * @function 咪咕视频去广告\n * @date 2025-06-27 23:00:00\n */\n\nconst $ = new\
      \ Env(\"咪咕视频去广告\");\nlet req_url = $request.url;\nlet rsp_body = \"{}\";\nif (typeof $response !== 'undefined' && $response\
      \ !== null) {\n  rsp_body = $response.body;\n}\n\nlet mod_rsp = rsp_body;\ntry {\n  mod_rsp = JSON.parse(rsp_body);\n\
      \n  if (req_url.includes(\"/display/v3/static/PERSONAL_CENTER\") && req_url.endsWith(\"PERSONAL_CENTER\")) {\n    if\
      \ (mod_rsp.body.groups && Array.isArray(mod_rsp.body.groups)) {\n      mod_rsp.body.groups = mod_rsp.body.groups.filter(group\
