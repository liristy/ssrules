                item.display_duration = 0;
              }
            }
          }
        } else if (url.includes("/wbapplua/wbpullad.lua") || url.includes("/preload/get_ad")) {
          // 开屏广告
          if (obj?.cached_ad?.ads?.length > 0) {
            for (let item of obj.cached_ad.ads) {
              item.show_count = 50;
